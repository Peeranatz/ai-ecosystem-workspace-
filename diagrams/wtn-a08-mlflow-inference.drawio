<mxfile host="65bd71144e">
    <diagram id="WTN-A08-MLflow-Inference" name="WTN-A08 Architecture">
        <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                
                <!-- Title -->
                <mxCell id="title" value="&lt;font color=&quot;#1F4E78&quot;&gt;&lt;b style=&quot;font-size: 18px;&quot;&gt;WTN-A08: MLflow Tracking &amp; Inference Worker Architecture&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 12px; color: #555555;&quot;&gt;FastAPI, Redis Job Queue, MLflow Model Registry, PostgreSQL &amp; MinIO Object Storage&lt;/span&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
                    <mxGeometry x="250" y="20" width="600" height="50" as="geometry"/>
                </mxCell>

                <!-- /Predict Box -->
                <mxCell id="predict_req" value="&lt;font color=&quot;#000000&quot;&gt;&lt;b style=&quot;font-size: 14px;&quot;&gt;/Predict&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size: 11px;&quot;&gt;Request / Response&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=20;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="80" y="120" width="200" height="70" as="geometry"/>
                </mxCell>

                <!-- FastAPI Server -->
                <mxCell id="fastapi" value="&lt;font color=&quot;#ffffff&quot;&gt;&lt;b style=&quot;font-size: 15px;&quot;&gt;FastAPI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;ai_fastapi (Port 8000)&lt;/span&gt;&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#007acc;strokeColor=#005999;" vertex="1" parent="1">
                    <mxGeometry x="90" y="280" width="180" height="120" as="geometry"/>
                </mxCell>

                <!-- Redis Queue -->
                <mxCell id="redis" value="&lt;font color=&quot;#ffffff&quot;&gt;&lt;b style=&quot;font-size: 14px;&quot;&gt;Redis&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;inference_job_queue (Port 6379)&lt;/span&gt;&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#c0392b;strokeColor=#962d22;" vertex="1" parent="1">
                    <mxGeometry x="340" y="440" width="180" height="110" as="geometry"/>
                </mxCell>

                <!-- PostgreSQL -->
                <mxCell id="postgres" value="&lt;font color=&quot;#ffffff&quot;&gt;&lt;b style=&quot;font-size: 13px;&quot;&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;MLflow DB Store (Port 5433)&lt;/span&gt;&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#2980b9;strokeColor=#1f618d;" vertex="1" parent="1">
                    <mxGeometry x="640" y="100" width="170" height="100" as="geometry"/>
                </mxCell>

                <!-- MinIO -->
                <mxCell id="minio" value="&lt;font color=&quot;#000000&quot;&gt;&lt;b style=&quot;font-size: 13px;&quot;&gt;MinIO&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;s3://mlflow/ (Port 9000/9001)&lt;/span&gt;&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#eaf2f8;strokeColor=#5499c7;" vertex="1" parent="1">
                    <mxGeometry x="880" y="250" width="170" height="100" as="geometry"/>
                </mxCell>

                <!-- MLflow Server -->
                <mxCell id="mlflow" value="&lt;font color=&quot;#ffffff&quot;&gt;&lt;b style=&quot;font-size: 14px;&quot;&gt;MLflow&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Tracking &amp; Registry (Port 5000)&lt;/span&gt;&lt;/font&gt;" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#16a085;strokeColor=#117864;" vertex="1" parent="1">
                    <mxGeometry x="630" y="240" width="190" height="120" as="geometry"/>
                </mxCell>

                <!-- Inference Worker -->
                <mxCell id="inference_worker" value="&lt;font color=&quot;#000000&quot;&gt;&lt;b style=&quot;font-size: 14px;&quot;&gt;Inference Worker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;ai_inference_worker (PyTorch/CPU)&lt;/span&gt;&lt;/font&gt;" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f9e79f;strokeColor=#f39c12;" vertex="1" parent="1">
                    <mxGeometry x="610" y="440" width="240" height="110" as="geometry"/>
                </mxCell>

                <!-- Arrows -->
                <!-- 1. Predict -> FastAPI -->
                <mxCell id="e1" value="" style="endArrow=classic;startArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="predict_req" target="fastapi">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- 2. FastAPI -> Redis (Enqueue) -->
                <mxCell id="e2" value="&lt;font color=&quot;#007acc&quot;&gt;&lt;b&gt;Enqueue Job&lt;/b&gt;&lt;/font&gt;" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#007acc;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="fastapi" target="redis">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- 3. Redis <-> Inference Worker -->
                <mxCell id="e3" value="&lt;font color=&quot;#c0392b&quot;&gt;&lt;b&gt;Poll Queue &amp; Write Result&lt;/b&gt;&lt;/font&gt;" style="endArrow=classic;startArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#c0392b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="redis" target="inference_worker">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- 4. MLflow <-> PostgreSQL -->
                <mxCell id="e4" value="" style="endArrow=classic;startArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#2980b9;" edge="1" parent="1" source="mlflow" target="postgres">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- 5. PostgreSQL <-> MinIO -->
                <mxCell id="e5" value="" style="endArrow=classic;startArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#5499c7;" edge="1" parent="1" source="postgres" target="minio">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- 6. MLflow <-> MinIO -->
                <mxCell id="e6" value="" style="endArrow=classic;startArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#16a085;" edge="1" parent="1" source="mlflow" target="minio">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- 7. Inference Worker -> MLflow (Load Model) -->
                <mxCell id="e7" value="&lt;font color=&quot;#16a085&quot;&gt;&lt;b&gt;Load Model from MLflow&lt;/b&gt;&lt;/font&gt;" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#16a085;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mlflow" target="inference_worker">
                    <mxGeometry relative="1" as="geometry"/>
